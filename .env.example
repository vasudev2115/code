# AEGISNET SENTINEL Environment Configuration
# Copy this to .env and configure for your environment

# Database
AEGISNET_DATABASE_URL=sqlite:///./aegisnet.db
# For PostgreSQL: postgresql://user:password@localhost:5432/aegisnet

# JWT & Security
AEGISNET_JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
AEGISNET_DEMO_PASSWORD=changeme

# Redis (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (restrict in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
# For production, list specific domains:
# ALLOWED_ORIGINS=https://example.com,https://dashboard.example.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# HTTPS/TLS (optional, use reverse proxy in production)
ENABLE_HTTPS=false
SSL_CERT_FILE=
SSL_KEY_FILE=

# Logging
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# Environment
ENVIRONMENT=development
# development, staging, production
